(in-package #:zk-llvm/tests)

(defun test-global-aliases ()
  (llvm:with-llvm-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:parse-ir context "@number = global i32 41
                                             @new = global i32 42"))
           (number (llvm:find-global module "number"))
           (new (llvm:find-global module "new"))
           (alias (llvm:add-global-alias module "answer" :i32 number :linkage :internal))
           (chain (llvm:add-global-alias module "chain" :i32 alias)))
      (assert (llvm:global-alias-p alias))
      (assert (eq :internal (llvm:global-alias-linkage alias)))
      (assert (= 0 (llvm:global-alias-address-space alias)))
      (assert (eq :integer (llvm:type-kind (llvm:global-alias-value-type alias))))
      (assert (string= "answer" (llvm:global-alias-name alias)))
      (assert (string= "number" (llvm:value-name (llvm:global-alias-target alias))))
      (assert (string= "answer" (llvm:value-name (llvm:global-alias-address alias))))
      (assert (llvm:global-alias-equal-p alias (llvm:find-global-alias module "answer")))
      (assert (equal '("answer" "chain")
                     (mapcar #'llvm:global-alias-name (llvm:module-global-aliases module))))
      (let ((failure (handler-case (llvm:set-global-alias-target alias chain)
                       (llvm:llvm-error (condition) condition))))
        (assert (eq 'llvm:set-global-alias-target (llvm:llvm-error-operation failure))))
      (llvm:set-global-alias-target alias new)
      (llvm:set-global-alias-name alias "renamed")
      (assert (null (llvm:find-global-alias module "answer")))
      (assert (string= "renamed" (llvm:value-name (llvm:global-alias-target chain))))
      (assert (string= "new" (llvm:value-name (llvm:global-alias-target alias))))
      (llvm:release module)
      (assert (llvm:verify-module (llvm:global-alias-module alias))))))
