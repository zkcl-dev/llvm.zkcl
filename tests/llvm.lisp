(defun test-module-data ()
  (llvm:with-llvm-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:make-module context "data"))
           (other (llvm:make-module context "other"))
           (i32 (llvm:int-type context 32))
           (array (llvm:const-array i32 (list (llvm:const-int i32 17)
                                               (llvm:const-int i32 25))))
           (pair (llvm:struct-type context (list (llvm:value-type array) i32)))
           (initializer (llvm:const-struct pair (list array (llvm:const-int i32 0))))
           (data (llvm:add-global module "data" pair :initializer initializer
                                   :constant t :linkage :private))
           (octets (make-array 3 :element-type '(unsigned-byte 8) :initial-contents '(65 0 255)))
           (bytes (llvm:const-bytes context octets :nul-terminated t))
           (signature (llvm:function-type i32 (list i32)))
           (function (llvm:add-function module "read" signature))
           (builder (llvm:make-builder context)))
      (assert (string= "[4 x i8]" (llvm:type-ir (llvm:value-type bytes))))
      (assert (string= "data" (llvm:global-name (llvm:find-global module "data"))))
      (assert (llvm:global-constant-p data))
      (assert (string= "ptr" (llvm:type-ir (llvm:value-type (llvm:global-address data)))))
      (assert (string= "{ [2 x i32], i32 }" (llvm:type-ir (llvm:global-storage-type data))))
      (assert (string= "read" (llvm:function-name function)))
      (assert (string= "i32 (i32)" (llvm:type-ir (llvm:function-signature function))))
      (let* ((pointer (llvm:global-address data))
             (failure (handler-case
                          (progn (llvm:add-global other "bad" (llvm:pointer-type context)
                                                       :initializer pointer)
                                 nil)
                        (llvm:llvm-error (condition) condition))))
        (assert (typep failure 'llvm:llvm-error))
        (assert (eq 'llvm:add-global (llvm:llvm-error-operation failure)))
        (assert (search "different modules" (llvm:llvm-error-message failure)))
        (assert (null (llvm:find-global other "bad"))))
      (llvm:position-at-end builder (llvm:append-block function "entry"))
      (let* ((aggregate (llvm:build-load builder pair (llvm:global-address data) "table"))
             (updated (llvm:build-insert-value builder aggregate (llvm:parameter function 0) 1
                                                 "updated"))
