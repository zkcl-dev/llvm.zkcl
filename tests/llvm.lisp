        (assert (= 32767 (funcall invert-u16 32768)))
        (assert (= 0 (funcall invert-u16 65535)))
        (dolist (case (list (list invert-bit 2)
                            (list invert-i8 -129) (list invert-i8 128)
                            (list invert-u16 -1) (list invert-u16 65536)))
          (destructuring-bind (function argument) case
            (assert (handler-case (progn (funcall function argument) nil)
                      (type-error (condition) (eql argument (type-error-datum condition)))))))))))

(defun test-jit-tracker-callback-reentry ()
  (llvm:with-objects ()
    (llvm:with-jit (jit)
      (let ((tracker (llvm:make-resource-tracker jit))
            (context (llvm:make-context))
            (release-entry nil))
        (llvm:jit-define-symbol
         jit "tracker_callback"
         (ffi:make-callback
          (lambda (input)
            (assert (handler-case (progn (llvm:remove-resource-tracker tracker) nil)
                      (llvm:llvm-error (condition)
                        (and (eq 'llvm:remove-resource-tracker (llvm:llvm-error-operation condition))
                             (search "live JIT symbols" (llvm:llvm-error-message condition))))))
            (assert (handler-case (progn (funcall release-entry) nil)
                      (llvm:llvm-error (condition)
                        (eq 'llvm:release (llvm:llvm-error-operation condition)))))
            (when (minusp input) (error "tracker callback rejected input"))
            (1+ input))
          :int32 :int32))
        (llvm:jit-add-module
         jit (llvm:parse-ir context
                           "declare i32 @tracker_callback(i32)
                            define i32 @tracked_entry(i32 %input) {
                              %result = call i32 @tracker_callback(i32 %input)
                              ret i32 %result
                            }")
         :tracker tracker)
        (multiple-value-bind (entry release) (llvm:jit-bind jit "tracked_entry" :i32 :i32)
          (setf release-entry release)
          (assert (= 42 (funcall entry 41)))
          (assert (handler-case (progn (funcall entry -1) nil)
                    (error (condition)
                      (search "tracker callback rejected input" (princ-to-string condition)))))
          (funcall release))
        (llvm:remove-resource-tracker tracker)
        (assert (handler-case (progn (llvm:jit-lookup jit "tracked_entry") nil)
                  (llvm:llvm-error (condition)
                    (eq 'llvm:jit-lookup (llvm:llvm-error-operation condition)))))))))

(defun test-vector-operations-and-constant-gep ()
  (llvm:with-objects ()
    (let* ((module
             (llvm:define-module (module "vector-operations")
               (let* ((samples (llvm:defglobal 'samples '(:array :i32 3)
                                                :initializer '(7 13 22) :constant t
                                                :linkage :private))
                      (field (llvm:const-gep '(:array :i32 3) samples '(0 2) :in-bounds t))
                      (selected (llvm:defglobal 'selected :ptr
                                                  :initializer field :linkage :internal)))
                 (llvm:set-global-alignment samples 32)
                 (assert (= 32 (llvm:global-alignment samples)))
                 (llvm:set-global-unnamed-address samples :global)
                 (assert (eq :global (llvm:global-unnamed-address samples)))
                 (assert (eq :private (llvm:global-linkage samples)))
                 (assert (eq :internal (llvm:global-linkage selected)))
                 (llvm:defir selected-sample () :i32
                   (llvm:load :i32 (llvm:load :ptr selected)))
                 (llvm:defir vector-score ((x :i32)) :i32
                   (let* ((a (llvm:insert-element (llvm:const-splat '(:vector :i32 4) 2) x 2))
                          (b (llvm:+ a '(10 20 30 40)))
                          (mask (llvm:const-vector '(:vector :i32 4) '(2 5 0 4)))
                          (shuffled (llvm:shuffle-vector b a mask)))
                     (llvm:extract-element (llvm:freeze shuffled) 0)))
                 (llvm:defir vector-float ((x :f32)) :f32
                   (let* ((a (llvm:insert-element (llvm:const-splat '(:vector :f32 2) 1.0) x 1))
                          (b (llvm:* a '(2.0 3.0)))
                          (mask (llvm:> a '(0.0 0.0))))
                     (llvm:extract-element (llvm:select mask b a) 1))))))
           (entry (first (llvm:function-blocks (llvm:find-function module "selected_sample"))))
           (load (first (llvm:block-instructions entry))))
      (llvm:set-instruction-alignment load 8)
      (assert (= 8 (llvm:instruction-alignment load)))
      (assert (llvm:verify-module module))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (assert (= 22 (funcall (llvm:jit-bind jit 'selected-sample :i32))))
        (assert (= 42 (funcall (llvm:jit-bind jit 'vector-score :i32 :i32) 12)))
        (let ((calculate (llvm:jit-bind jit 'vector-float :f32 :f32)))
          (assert (= 9.0 (funcall calculate 3.0)))
          (assert (= -3.0 (funcall calculate -3.0))))))))

(defun test-module-edit-retry ()
  (llvm:with-objects ()
    (llvm:with-context ()
      (let* ((source (llvm:parse-ir "define i32 @adjust(i32 %x) {
        entry:
          %amount = add i32 %x, 1
          %result = mul i32 %amount, 2
          ret i32 %result
        }"))
             (function (llvm:find-function source "adjust"))
             (instructions (llvm:block-instructions (first (llvm:function-blocks function))))
             (amount (first instructions))
             (result (second instructions))
             (edit (llvm:begin-edit source))
             (original (llvm:module-ir source)))
        (assert (llvm:module-edit-p edit))
        (llvm:edit-replace-operand edit amount 0 (llvm:instruction-result result))
        (assert (handler-case (progn (llvm:finish-edit edit) nil)
                  (llvm:llvm-error (condition)
                    (eq 'llvm:finish-edit (llvm:llvm-error-operation condition)))))
        (llvm:edit-replace-operand edit amount 0 (llvm:parameter function 0))
        (llvm:edit-replace-operand edit amount 1 (llvm:const :i32 8))
        (let ((revised (llvm:finish-edit edit)))
          (assert (llvm:verify-module revised))
          (assert (search "%x, 8" (llvm:module-ir revised)))
          (assert (string= original (llvm:module-ir source)))
          (assert (search "%x, 1" (llvm:instruction-ir amount))))))))

(defun test-copy-and-block-edits ()
  (llvm:with-objects ()
    (let* ((source (llvm:with-context ()
                     (llvm:parse-ir "define i32 @advance(i32 %value) {
                 entry: br label %original
                 original: ret i32 %value
                }")))
           (original-ir (llvm:module-ir source))
           (copy (llvm:with-module-copy (copy source)
                   (let* ((function (llvm:find-function copy "advance"))
                          (entry (first (llvm:function-blocks function)))
                          (terminator (llvm:block-terminator entry))
                          (replacement (llvm:append-block function "replacement"))
                          (input (llvm:parameter function 0)))
                     (assert (llvm:block-equal-p entry (llvm:instruction-block terminator)))
                     (assert (string= "advance" (llvm:function-name (llvm:block-function entry))))
                     (let ((new-value (llvm:with-builder (:before terminator)
                                        (llvm:+ input 1))))
                       (llvm:with-builder (builder :block replacement)
                         (llvm:build-ret builder new-value))))))
           (function (llvm:find-function copy "advance")))
      (destructuring-bind (entry original replacement) (llvm:function-blocks function)
        (let ((revised (llvm:with-module-edit (edit copy)
                         (llvm:edit-move-block-before edit replacement original)
                         (llvm:edit-redirect-successor edit (llvm:block-terminator entry) 0 replacement)
                         (llvm:edit-erase-block edit original))))
          (assert (string= original-ir (llvm:module-ir source)))
          (assert (equal '("entry" "replacement")
                         (mapcar #'llvm:block-name (llvm:function-blocks (llvm:find-function revised "advance")))))
          (llvm:with-jit (jit)
            (llvm:jit-add-module jit revised)
            (multiple-value-bind (advance release) (llvm:jit-bind jit "advance" :i32 :i32)
              (unwind-protect (assert (= 42 (funcall advance 41)))
                (funcall release)))))))))

(defun test-module-metadata-and-symbols ()
  (llvm:with-objects ()
    (let ((module
            (llvm:define-module (module "metadata-and-symbols")
              (let ((size (llvm:value-metadata (llvm:const :i32 16)))
                    (counter (llvm:defglobal "counter" :i32 :initializer 0 :address-space 3)))
                (llvm:module-set-identifier module "runtime")
                (llvm:module-set-source-filename module "runtime.tiny")
                (llvm:module-add-named-metadata module "zk.types"
                    (llvm:metadata-node (list (llvm:metadata-string "record") size)))
                (llvm:module-add-flag module "zk.layout-version" :max size)
                (llvm:set-global-thread-local-mode counter :local-exec)
                (llvm:set-global-visibility counter :hidden)
                (llvm:set-global-section counter ".zk.data")))))
      (assert (string= "runtime" (llvm:module-identifier module)))
      (let* ((decoded (llvm:parse-bitcode (llvm:make-context) (llvm:module-bitcode module)))
             (node (first (llvm:module-named-metadata decoded "zk.types")))
             (counter (llvm:find-global decoded "counter")))
        (assert (string= "runtime.tiny" (llvm:module-source-filename decoded)))
        (destructuring-bind (name size) (llvm:metadata-operands node)
          (assert (string= "record" (llvm:metadata-string-value name)))
          (assert (= 16 (llvm:metadata-integer-value size))))
        (multiple-value-bind (value behavior) (llvm:module-flag decoded "zk.layout-version")
          (assert (eq behavior :max))
          (assert (= 16 (llvm:metadata-integer-value value))))
        (assert (= 3 (llvm:global-address-space counter)))
        (assert (eq :local-exec (llvm:global-thread-local-mode counter)))
        (assert (eq :hidden (llvm:global-visibility counter)))
        (assert (string= ".zk.data" (llvm:global-section counter)))))))

(defun test-switch-splice-and-ondemand-jit ()
  (llvm:with-objects ()
    (llvm:with-context ()
      (let* ((source (llvm:parse-ir "define i32 @choose(i32 %key) {
        entry:
          %fallback_value = add i32 %key, 5
          %chosen_value = add i32 %key, 10
          switch i32 %key, label %fallback [ i32 1, label %chosen ]
        chosen:
          %selected = phi i32 [ %chosen_value, %entry ]
          ret i32 %selected
        fallback:
          ret i32 %fallback_value
      }"))
             (original (llvm:module-ir source))
             (function (llvm:find-function source "choose")))
        (destructuring-bind (entry chosen fallback) (llvm:function-blocks function)
          (destructuring-bind (fallback-value chosen-value terminator) (llvm:block-instructions entry)
            (let* ((revised (llvm:with-module-edit (edit source)
                              (llvm:edit-detach-instruction edit chosen-value)
                              (llvm:edit-insert-instruction-before edit chosen-value fallback-value)
                              (llvm:edit-detach-block edit fallback)
                              (llvm:edit-insert-block-before edit fallback chosen)
                              (llvm:edit-remove-switch-case edit terminator (llvm:const :i32 1))
                              (llvm:edit-add-switch-case edit terminator (llvm:const :i32 2) chosen
                                (list (llvm:instruction-result chosen-value)))
                              (llvm:edit-add-switch-case edit terminator (llvm:const :i32 3) chosen
                                (list (llvm:instruction-result chosen-value)))))
                   (blocks (llvm:function-blocks (llvm:find-function revised "choose")))
                   (cases (llvm:switch-cases (llvm:block-terminator (first blocks)))))
              (assert (string= original (llvm:module-ir source)))
              (assert (equal '("entry" "fallback" "chosen") (mapcar #'llvm:block-name blocks)))
              (assert (equal '(2 3) (mapcar (lambda (case) (llvm:constant-integer (first case))) cases)))
              (llvm:with-jit (jit)
                (let ((tracker (llvm:make-resource-tracker jit)))
                  (llvm:jit-add-ir-module jit revised :tracker tracker)
                  (multiple-value-bind (choose release) (llvm:jit-bind jit "choose" :i32 :i32)
                    (unwind-protect
                        (progn (assert (= 6 (funcall choose 1)))
                               (assert (= 12 (funcall choose 2)))
                               (assert (= 13 (funcall choose 3))))
                      (funcall release)))
                  (llvm:remove-resource-tracker tracker))))))))))

(defun test-value-use-and-typed-instruction-queries ()
  (llvm:with-objects ()
    (llvm:with-context ()
      (let* ((module (llvm:parse-ir "
          declare void @marker()
          define i32 @inspect(ptr %base, i32 %x) {
          entry:
            %p = getelementptr inbounds [2 x i32], ptr %base, i32 0, i32 1
            %sum = add i32 %x, %x
            store i32 %sum, ptr %p, align 4
            call void @marker()
            ret i32 %sum
          }"))
             (function (llvm:find-function module "inspect"))
             (argument (llvm:parameter function 1)))
        (destructuring-bind (gep sum store call ret)
            (llvm:block-instructions (first (llvm:function-blocks function)))
          (assert (eq :argument (llvm:value-kind argument)))
          (assert (null (llvm:value-operands argument)))
          (assert (equal '(0 1) (mapcar #'second (llvm:value-uses argument))))
          (dolist (use (llvm:value-uses argument))
            (destructuring-bind (user index) use
              (assert (llvm:instruction-equal-p sum (llvm:value-instruction user)))
              (assert (llvm:value-equal-p argument (llvm:value-operand user index)))))
          (assert (llvm:value-equal-p (llvm:parameter function 0) (llvm:gep-pointer gep)))
          (assert (llvm:gep-in-bounds-p gep))
          (assert (equal '(0 1) (mapcar #'llvm:constant-integer (llvm:gep-index-operands gep))))
          (assert (eq :array (llvm:type-kind (llvm:gep-source-type gep))))
          (assert (llvm:value-equal-p (llvm:instruction-result gep) (llvm:store-pointer store)))
          (assert (llvm:value-equal-p (llvm:instruction-result sum) (llvm:stored-value store)))
          (assert (string= "marker" (llvm:function-name (llvm:value-function (llvm:call-target call)))))
          (assert (eq :function (llvm:type-kind (llvm:call-signature call))))
          (assert (equal '(nil t) (multiple-value-list (llvm:call-arguments call))))
          (assert (equal '(nil nil) (multiple-value-list (llvm:call-arguments ret)))))))))

