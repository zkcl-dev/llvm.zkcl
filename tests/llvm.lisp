(defun test-jit-host-imports ()
  (let ((fee (ffi:allocate (ffi:type-size :int64))))
    (unwind-protect
         (llvm:with-llvm-objects ()
           (let* ((root (llvm:make-jit))
                  (child (llvm:make-jit-dylib root "host-imports"))
                  (context (llvm:make-context))
                  (module (llvm:parse-ir context "@host_fee = external global i64
                    declare i64 @host_adjust(i64)
                    define i64 @compute(i64 %input) {
                      %adjusted = call i64 @host_adjust(i64 %input)
                      %fee = load i64, ptr @host_fee
                      %result = add i64 %adjusted, %fee
                      ret i64 %result }"))
                  (callback (ffi:make-callback
                             (lambda (input)
                               (when (minusp input) (error "host callback rejected input"))
                               (+ input 20))
                             :int64 :int64))
                  (observer (zk:make-weak-pointer callback)))
             (setf (ffi:mem-ref fee :int64) 3)
             (llvm:jit-define-symbol root "host_adjust" callback)
             (llvm:jit-define-symbol root "host_fee" fee :kind :data)
             (setq callback nil)
             (llvm:close-jit root)
             (llvm:release root)
             (zk:gc)
             (assert (zk:weak-pointer-value observer))
             (llvm:jit-add-module child module)
             (let* ((symbol (llvm:jit-lookup child "compute"))
                    (compute (llvm:bind-jit-function symbol :int64 :int64)))
               (llvm:close-jit child)
               (llvm:release child)
               (zk:gc)
               (assert (= 42 (funcall compute 19)))
               (assert (handler-case (progn (funcall compute -1) nil)
                         (error (condition)
                           (search "host callback rejected input" (princ-to-string condition)))))
               (setf (ffi:mem-ref fee :int64) 4)
               (assert (= 43 (funcall compute 19)))
               (llvm:release symbol)
               (zk:gc)
               (assert (null (zk:weak-pointer-value observer))))))
      (ffi:free fee))))

