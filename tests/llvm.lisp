           (i32 (llvm:int-type context 32))
           (ptr (llvm:pointer-type context))
           (builder (llvm:make-builder context))
           (step (llvm:add-function module "step" (llvm:function-type i8 (list i8))
                                      :linkage :internal))
           (apply-step (llvm:add-function module "apply_step"
                        (llvm:function-type i32 (list ptr i8)) :linkage :internal))
           (run (llvm:add-function module "run_step" (llvm:function-type i32 nil))))
      (llvm:set-function-attribute run :return "range" '(:range 32 -64 1))
      (let ((range (llvm:function-attribute run :return "range")))
        (assert (eq (getf range :kind) :range))
        (assert (equal '(:bit-width 32 :lower -64 :upper 1) (getf range :value))))
      (llvm:set-function-calling-convention step :fast)
      (assert (= 8 (llvm:function-calling-convention step)))
      (llvm:set-function-attribute step :return "signext")
      (llvm:set-function-attribute step 0 "signext")
      (assert (llvm:function-has-attribute-p step :return "signext"))
      (llvm:set-function-attribute step :function "source-note" "step")
      (assert (llvm:function-has-attribute-p step :function "source-note"))
      (llvm:remove-function-attribute step :function "source-note")
      (assert (not (llvm:function-has-attribute-p step :function "source-note")))
      (assert (handler-case (progn (llvm:set-function-attribute step 1 "signext") nil)
                (llvm:llvm-error (condition)
                  (eq 'llvm:set-function-attribute (llvm:llvm-error-operation condition)))))
      (llvm:position-at-end builder (llvm:append-block step "entry"))
      (llvm:build-ret builder (llvm:build-add builder (llvm:parameter step 0)
                                                   (llvm:const-int i8 23)))
      (llvm:position-at-end builder (llvm:append-block apply-step "entry"))
      (let* ((llvm:*builder* builder)
             (call (llvm:indirect-call-instruction step (llvm:parameter apply-step 0)
                                                           (llvm:parameter apply-step 1))))
        (assert (llvm:instruction-p call))
        (assert (= 8 (llvm:call-calling-convention call)))
        (llvm:set-call-calling-convention call :fast)
        (assert (llvm:call-has-attribute-p call :return "signext"))
        (llvm:set-call-attribute call :function "nounwind")
        (assert (llvm:call-has-attribute-p call :function "nounwind"))
        (llvm:remove-call-attribute call :function "nounwind")
        (assert (not (llvm:call-has-attribute-p call :function "nounwind")))
        (assert (eq (llvm:tail-call-kind call) :none))
        (llvm:set-tail-call-kind call :notail)
        (assert (eq (llvm:tail-call-kind call) :notail))
        (llvm:build-ret builder
          (llvm:build-int-cast builder (llvm:instruction-result call) i32 :signed t)))
      (llvm:position-at-end builder (llvm:append-block run "entry"))
      (let* ((llvm:*builder* builder)
             (call (llvm:call-instruction apply-step (llvm:function-address step)
                                          (llvm:const-int i8 -65))))
        (llvm:set-tail-call-kind call :tail)
        (llvm:build-ret builder (llvm:instruction-result call)))
      (assert (search "notail call fastcc signext i8 %0(i8 signext" (llvm:module-ir module)))
      (let ((jit (llvm:make-jit)))
        (llvm:jit-add-module jit module)
        (assert (= -42 (funcall (llvm:bind-jit-function
                                  (llvm:jit-lookup jit "run_step") :int32))))))))

