(defun addition-module ()
  (llvm:define-module (m "addition")
    (llvm:defir add ((left :i32) (right :i32)) :i32
      (assert (null (llvm:parameter llvm:*function* 2)))
      (llvm:+ left right))))

(defun test-high-level-dsl ()
  (llvm:with-llvm-objects ()
    (llvm:with-context (ctx)
      (let* ((ty (llvm:resolve-type '(:struct :i32 (:array :f64 2) :ptr)))
             (val (llvm:const :i32 42)))
        (assert (llvm:context-p ctx))
        (assert (llvm:type-p ty))
        (assert (llvm:value-p val))
        (assert (search "{ i32, [2 x double], ptr }" (princ-to-string ty)))
        (assert (search "i32 42" (princ-to-string val)))))

    (let ((abs-diff (llvm:jit-fn "abs_diff" ((a :i32) (b :i32)) :i32
                      (llvm:if (llvm:>= a b)
                        (llvm:- a b)
                        (llvm:- b a))))
          (sum-to (llvm:jit-fn "sum_to" ((limit :i32)) :i32
                    (let ((acc (llvm:alloca :i32 0 "acc"))
                          (i (llvm:alloca :i32 1 "i")))
                      (llvm:while (llvm:<= (llvm:load :i32 i) limit)
                        (let ((cur (llvm:load :i32 i)))
                          (llvm:store (llvm:+ (llvm:load :i32 acc) cur) acc)
                          (llvm:store (llvm:+ cur 1) i)))
                      (llvm:load :i32 acc))))
          (classify (llvm:jit-fn "classify" ((x :i32)) :i32
                      (llvm:cond (:type :i32)
                        ((llvm:< x 0) -1)
                        ((llvm:= x 0) 0)
                        (:else 1))))
          (switch-op (llvm:jit-fn "switch_op" ((op :i32) (x :i32)) :i32
                       (llvm:switch op
                         (0 (llvm:+ x 10))
                         ((1 2) (llvm:* x 2))
                         (:default -1)))))
      (assert (= 15 (funcall abs-diff 25 10)))
      (assert (= 15 (funcall abs-diff 10 25)))
      (assert (= 55 (funcall sum-to 10)))
      (assert (= -1 (funcall classify -9)))
      (assert (= 0 (funcall classify 0)))
      (assert (= 1 (funcall classify 7)))
      (assert (= 15 (funcall switch-op 0 5)))
      (assert (= 10 (funcall switch-op 1 5)))
      (assert (= 10 (funcall switch-op 2 5)))
      (assert (= -1 (funcall switch-op 9 5))))))

(defun test-structured-values ()
  (llvm:with-llvm-objects ()
    (let* ((module
             (llvm:define-module (m "structured-values")
               (llvm:defir literal-add () :i64
                 (llvm:+ (llvm:const :i64 4294967296) 1))
               (llvm:defir literal-if ((input :i32)) :i64
                 (llvm:if (llvm:< input 0) -4294967297 4294967297 :type :i64))
               (llvm:defir literal-cond ((input :i32)) :i64
                 (llvm:cond (:type :i64)
                   ((llvm:< input 0) -4294967297)
                   ((llvm:= input 0) 0)
                   (:else 4294967297)))
               (llvm:defir literal-switch ((key :i32)) :i64
                 (llvm:switch key (:type :i64)
                   ((1 2) 4294967297)
                   (:default -4294967297)))
               (llvm:defir nested ((key :i32) (input :i32)) :i64
                 (let ((value (llvm:switch key (:type :i32)
                                (0 (llvm:ret 42)
                                   (error "Emitted code after LLVM:RET."))
                                (1 (llvm:cond (:type :i32)
                                     ((llvm:< input 0) 10)
                                     (:else (llvm:if (llvm:= input 0) 20 30 :type :i32))))
                                (:default 40))))
                   (llvm:int-cast (llvm:+ value 2) :i64 :signed t)))
               (llvm:defir literal-boolean ((input :i32)) :i32
                 (llvm:int-cast (llvm:if (llvm:= input 0) nil t :type :i1) :i32))))
           (ir (llvm:module-ir module)))
      (assert (llvm:verify-module module))
      (assert (search "phi i64 [ -4294967297" ir))
      (assert (search "phi i32" ir))
      ;; Verification checks each PHI's incoming blocks against its actual predecessors.
      (assert (search "[ 40, %switch.default ]" ir))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (assert (= 4294967297 (funcall (llvm:jit-bind jit "literal_add" :i64))))
        (let ((literal-if (llvm:jit-bind jit "literal_if" :i64 :i32))
              (literal-cond (llvm:jit-bind jit "literal_cond" :i64 :i32))
              (literal-switch (llvm:jit-bind jit "literal_switch" :i64 :i32))
              (nested (llvm:jit-bind jit "nested" :i64 :i32 :i32))
              (literal-boolean (llvm:jit-bind jit "literal_boolean" :i32 :i32)))
          (assert (= -4294967297 (funcall literal-if -1)))
          (assert (= 4294967297 (funcall literal-if 0)))
          (assert (= -4294967297 (funcall literal-cond -1)))
          (assert (= 0 (funcall literal-cond 0)))
          (assert (= 4294967297 (funcall literal-cond 1)))
          (assert (= 4294967297 (funcall literal-switch 1)))
          (assert (= 4294967297 (funcall literal-switch 2)))
          (assert (= -4294967297 (funcall literal-switch 3)))
          (assert (= 42 (funcall nested 0 0)))
          (assert (= 12 (funcall nested 1 -1)))
          (assert (= 22 (funcall nested 1 0)))
          (assert (= 32 (funcall nested 1 1)))
          (assert (= 42 (funcall nested 2 1)))
          (assert (= 0 (funcall literal-boolean 0)))
          (assert (= 1 (funcall literal-boolean 1))))))))

(defun test-terminated-arms ()
  (llvm:with-llvm-objects ()
    (let ((module (llvm:define-module (m "terminated-arms")
                    (llvm:defir if-one-live ((input :i32)) :i32
                      (llvm:if (llvm:< input 0) (llvm:ret 42) (llvm:+ input 1)))
                    (llvm:defir switch-one-live ((input :i32)) :i32
                      (llvm:switch input (:type :i32)
                        (0 (llvm:ret 42))
                        (1 (llvm:ret 43))
                        (:default 44)))
                    (llvm:defir if-all-terminated ((input :i32)) :i32
                      (llvm:if (llvm:< input 0) (llvm:ret 41) (llvm:ret 42))))))
      (assert (llvm:verify-module module))
      (assert (null (search "phi " (llvm:module-ir module))))
      (assert (= 3 (length (llvm:function-blocks
                             (llvm:find-function module "if_all_terminated")))))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (let ((if-one (llvm:jit-bind jit "if_one_live" :i32 :i32))
              (switch-one (llvm:jit-bind jit "switch_one_live" :i32 :i32))
              (if-all (llvm:jit-bind jit "if_all_terminated" :i32 :i32)))
          (assert (= 42 (funcall if-one -1)))
          (assert (= 43 (funcall if-one 42)))
          (assert (= 42 (funcall switch-one 0)))
          (assert (= 43 (funcall switch-one 1)))
          (assert (= 44 (funcall switch-one 2)))
          (assert (= 41 (funcall if-all -1)))
          (assert (= 42 (funcall if-all 0))))))))

(defun test-local-literal-typing ()
  (llvm:with-objects ()
    (llvm:with-module (module "literal-boundaries")
      (assert (handler-case
                  (progn
                    (llvm:defir incorrect-width () :i1 (llvm:> 300 1))
                    nil)
                (error (condition) (search "type" (string-downcase (princ-to-string condition))))))
      (assert (handler-case
                  (progn
                    (llvm:defir unknown-arm-width ((condition :i1)) :i64
                      (llvm:if condition 100 50)
                      0)
                    nil)
                (error (condition) (search "type" (string-downcase (princ-to-string condition))))))
      (assert (handler-case (progn (llvm:const :i8 256) nil)
                (llvm:llvm-error (condition)
                  (eq 'llvm:const (llvm:llvm-error-operation condition)))))
      (assert (search "i8 0" (llvm:value-ir (llvm:const-int :i8 256)))))
    (let ((compare (llvm:jit-fn correct-width () :i1
                     (llvm:> (llvm:const :i64 300) 1))))
      (assert (= 1 (funcall compare))))
    (let ((null-p (llvm:jit-fn is-null ((address :ptr)) :i1
                    (llvm:= address nil))))
      (assert (= 1 (funcall null-p nil)))
      (ffi:with-foreign-memory (address 1)
        (assert (= 0 (funcall null-p address)))))))

(defun test-programmatic-emission ()
  (llvm:with-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:make-module context "programmatic"))
           (global (llvm:add-global module "offset" :i32 :initializer 1))
           (helper (llvm:declare-function module "increment" :i32 '(:i32)))
           (caller (llvm:declare-function module "invoke_increment" :i32 '(:i32))))
      (assert (handler-case (progn (llvm:emit-function-body helper '() #'identity) nil)
                (error () t)))
      (assert (null (llvm:function-blocks helper)))
      (llvm:release module)
      (assert (eq :i32 (llvm:type-spec (llvm:global-storage-type global))))
      (llvm:with-module (other "other" :context context)
        (assert (eq helper
                    (llvm:emit-function-body helper '("value")
                      (lambda (parameters)
                        (assert (eq helper llvm:*function*))
                        (assert (eq (llvm:function-module helper) llvm:*module*))
                        (assert (not (eq other llvm:*module*)))
                        (let ((input (first parameters)))
                          (assert (not (llvm:value-constant-p input)))
                          (assert (handler-case (progn (llvm:const :i32 input) nil)
                                    (llvm:llvm-error (condition)
                                      (eq 'llvm:const (llvm:llvm-error-operation condition)))))
                          (assert (llvm:value-constant-p (llvm:global-initializer global)))
                          (let ((folded (llvm:+ (llvm:const :i32 20) 22)))
                            (assert (llvm:value-constant-p folded))
                            (assert (llvm:add-global other "folded" :i32 :initializer folded)))
                          (llvm:ret (llvm:+ input (llvm:load :i32 global))))))))
        (llvm:emit-function-body caller '("input")
          (lambda (parameters)
            (llvm:ret (llvm:call 'increment (first parameters))))))
      (let ((module (llvm:function-module caller)))
        (assert (llvm:verify-module module))
        (llvm:with-jit (jit)
          (llvm:jit-add-module jit module)
          (assert (= 42 (funcall (llvm:jit-bind jit 'invoke-increment :i32 :i32) 41))))))))

(defun test-loop-terminators ()
  (let ((sum-skipping-evens
          (llvm:jit-fn "sum_skipping_evens" ((limit :i32)) :i32
            (let ((sum (llvm:alloca :i32 0 "sum"))
                  (index (llvm:alloca :i32 0 "index")))
              (llvm:while (llvm:< (llvm:load :i32 index) limit)
                (let ((next (llvm:+ (llvm:load :i32 index) 1)))
                  (llvm:store next index)
                  (llvm:when (llvm:>= next 7)
                    (llvm:break)
                    (error "Emitted code after LLVM:BREAK."))
                  (llvm:unless (llvm:/= (llvm:rem next 2) 0)
                    (llvm:continue)
                    (error "Emitted code after LLVM:CONTINUE."))
                  (llvm:store (llvm:+ (llvm:load :i32 sum) next) sum)))
              (llvm:load :i32 sum)))))
    (assert (= 0 (funcall sum-skipping-evens 0)))
    (assert (= 4 (funcall sum-skipping-evens 4)))
    (assert (= 9 (funcall sum-skipping-evens 10)))))

(defun test-ssa-loop-property ()
  (llvm:with-llvm-objects ()
    (llvm:with-jit (unoptimized-jit)
      (llvm:with-jit (optimized-jit)
        (let* ((module
                 (llvm:define-module (m "ssa-loop" :jit unoptimized-jit)
                   (llvm:defir weighted-sum ((limit :i32) (mode :i32)) :i32
                     (llvm:loop ((index :i32 1) (sum :i32 0)) :i32
                       (llvm:cond
                         ((llvm:< limit 0) (llvm:break -7))
                         ((llvm:> index limit) (llvm:break sum))
                         ((llvm:= (llvm:rem index 2) 0)
                          (llvm:recur (llvm:+ index 1) (llvm:- sum index)))
                         (:else
                          (let ((delta (llvm:switch mode
                                         ((0 1) index)
                                         (-1 (llvm:- index))
                                         (:default (llvm:+ index 5)))))
                            (llvm:recur (llvm:+ index 1) (llvm:+ sum delta)))))))))
               (ir (llvm:module-ir module)))
          (assert (llvm:verify-module module))
          (assert (search "phi i32" ir))
          (assert (null (search "alloca" ir)))
          (llvm:jit-add-module unoptimized-jit module)
          (llvm:jit-add-module optimized-jit (llvm:optimize-module module :o2))
          (let ((unoptimized (llvm:jit-bind unoptimized-jit "weighted_sum" :i32 :i32 :i32))
                (optimized (llvm:jit-bind optimized-jit "weighted_sum" :i32 :i32 :i32)))
            (zk-pbt:forall
             (zk-pbt:tuple (zk-pbt:integers :min -5 :max 32)
                           (zk-pbt:integers :min -2 :max 3))
             (lambda (input)
               (destructuring-bind (limit mode) input
                 (let* ((expected (if (minusp limit)
                                      -7
                                      (loop for index from 1 to limit
                                            sum (cond ((evenp index) (- index))
                                                      ((member mode '(0 1)) index)
                                                      ((= mode -1) (- index))
                                                      (t (+ index 5))))))
                        (before (funcall unoptimized limit mode))
                        (after (funcall optimized limit mode)))
                   (zk-pbt:claim :unoptimized (= expected before) (list expected before))
                   (zk-pbt:claim :optimized (= expected after) (list expected after)))))
             :name 'ssa-loop-agrees-with-lisp :seed 42141 :trials 100)))))))

(defun test-declaration-attributes ()
  (llvm:with-llvm-objects ()
    (let* ((target (llvm:make-target-machine))
           (module
             (llvm:define-module (m "declaration-attributes" :target-machine target)
               (let* ((result-type (llvm:opaque-struct-type "Triple"))
                      (extension-attributes '((:return "signext") (0 "signext"))))
                 (llvm:set-struct-body result-type '(:i64 :i64 :i64))
                 (llvm:declare-ir triple-factory (:ptr :i8) :void
                   :attributes `((0 "sret" ,result-type)
                                 (0 "align" ,(llvm:target-abi-alignment target result-type))
                                 (1 "signext")))
                 (llvm:declare-ir signed-step (:i8) :i8
                   :linkage :internal :calling-convention :fast
                   :attributes extension-attributes)
                 (llvm:defir (signed-step :linkage :internal) ((input :i8)) :i8
                   (llvm:+ input 23))
                 (llvm:defir run-signed-step () :i32
                   (llvm:int-cast (llvm:call 'signed-step -65) :i32 :signed t)))))
           (ir (llvm:module-ir module)))
      (assert (llvm:verify-module module))
      (assert (search "sret(%Triple) align " ir))
      (let* ((factory (llvm:find-function module "triple_factory"))
             (align (llvm:function-attribute factory 0 "align")))
        (assert (eq (getf align :kind) :integer))
        (assert (plusp (getf align :value))))
      (assert (search "call fastcc signext i8 @signed_step(i8 signext" ir))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (assert (= -42 (funcall (llvm:jit-bind jit "run_signed_step" :i32))))))))

(defun test-ir-and-emission ()
  (llvm:with-llvm-objects ()
    (let* ((module (addition-module))
           (ir (llvm:module-ir module))
           (bitcode (llvm:module-bitcode module))
           (copy (llvm:parse-bitcode (llvm:make-context) bitcode))
           (machine (llvm:make-target-machine))
           (optimized (llvm:optimize-module copy :o2 :target-machine machine))
           (object (llvm:emit-object optimized machine)))
      (assert (llvm:module-p module))
      (assert (llvm:target-machine-p machine))
      (assert (search "add i32 %left, %right" ir))
      (assert (llvm:verify-module optimized))
      (assert (llvm:find-function copy "add"))
      (assert (null (llvm:find-function copy "absent")))
      (assert (string= ir (llvm:module-ir module)))
      (assert (typep object '(vector (unsigned-byte 8))))
      (assert (plusp (length object)))
      (assert (search "add" (llvm:emit-assembly optimized machine))))))

(defun test-instruction-inspection-and-rewrite ()
  (llvm:with-objects ()
    (let* ((context (llvm:make-context))
           (original (llvm:parse-ir context "define i32 @choose(i32 %x, i32 %test) {
             entry: %condition = icmp ne i32 %test, 0
                    br i1 %condition, label %then, label %else
             then: %plus = add i32 %x, 1
                   br label %merge
             else: %twice = mul i32 %x, 2
                   br label %merge
             merge: %result = phi i32 [ %plus, %then ], [ %twice, %else ]
                    ret i32 %result }"))
           (module (llvm:parse-bitcode context (llvm:module-bitcode original)))
           (blocks (llvm:function-blocks (llvm:find-function module "choose"))))
      (destructuring-bind (entry then else merge) blocks
        (let* ((branch (llvm:block-terminator entry))
               (plus (first (llvm:block-instructions then)))
               (twice (llvm:instruction-result (first (llvm:block-instructions else))))
               (phi (first (llvm:block-instructions merge)))
               (ret (llvm:block-terminator merge))
               (plus-input (llvm:instruction-operand plus 0)))
          (assert (llvm:instruction-p branch))
          (assert (null (llvm:instruction-result branch)))
          (assert (eq :br (llvm:instruction-opcode branch)))
          (assert (eq :label (llvm:type-kind (llvm:value-type (second (llvm:instruction-operands branch))))))
          (assert (search "label %then" (llvm:instruction-ir branch)))
          (assert (every #'llvm:block-equal-p (llvm:instruction-successors branch) (list then else)))
          (assert (equal '(:phi :ret) (mapcar #'llvm:instruction-opcode (llvm:block-instructions merge))))
          (assert (null (llvm:instruction-operand plus 2)))
          (assert (null (llvm:phi-incomings plus)))
          (assert (search "%plus = add" (princ-to-string plus)))
          (destructuring-bind ((yes yes-block) (no no-block)) (llvm:phi-incomings phi)
            (assert (llvm:value-equal-p yes (llvm:instruction-result plus)))
            (assert (llvm:value-equal-p no twice))
            (assert (llvm:block-equal-p then yes-block))
            (assert (llvm:block-equal-p else no-block)))

          (flet ((refuses-edit (instruction index replacement)
                   (handler-case (progn (llvm:replace-instruction-operand instruction index replacement) nil)
                     (llvm:llvm-error (condition)
                       (eq 'llvm:replace-instruction-operand (llvm:llvm-error-operation condition))))))
            (assert (refuses-edit plus 0 (llvm:const :i64 3 context)))
            (assert (refuses-edit plus 0 (llvm:const :i32 3 (llvm:make-context))))
            (assert (refuses-edit plus 0 twice))
            (assert (refuses-edit ret 0 (llvm:const :i32 3 context))))
          (assert (llvm:value-equal-p plus-input (llvm:instruction-operand plus 0)))
          (assert (llvm:verify-module module))
          (llvm:replace-instruction-operand plus 1 (llvm:const :i32 4 context))
          (assert (search "add i32 %x, 4" (llvm:instruction-ir plus)))
          (assert (search "add i32 %x, 1" (llvm:module-ir original)))
          (assert (llvm:verify-module module))
          (llvm:with-jit (jit)
            (llvm:jit-add-module jit module)
            (let ((choose (llvm:jit-bind jit "choose" :i32 :i32 :i32)))
              (assert (= 45 (funcall choose 41 1)))
              (assert (= 82 (funcall choose 41 0))))))))))

(defun test-function-definition ()
  (llvm:with-llvm-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:make-module context "declarations"))
           (i32 (llvm:int-type context 32))
           (step (llvm:declare-function module "step" i32 (list i32) :linkage :internal))
           (one (llvm:const-int i32 1)))
      (llvm:set-function-calling-convention step :fast)
      (llvm:define-function (run builder module "run" i32) ()
        (llvm:build-ret builder
          (llvm:build-call builder step (list (llvm:const-int i32 41)))))
      (assert (handler-case (progn (llvm:declare-function module "step" i32 nil) nil)
                (llvm:llvm-error (condition)
                  (search "different signature" (llvm:llvm-error-message condition)))))
      (assert (handler-case
                  (progn (llvm:declare-function module "step" i32 (list i32) :linkage :external)
                         nil)
                (llvm:llvm-error (condition)
                  (search "different linkage" (llvm:llvm-error-message condition)))))
      (let ((temporary-builder
              (catch 'emitted
                (llvm:define-function (step builder module "step" i32) ((input i32))
                  (llvm:build-ret builder (llvm:build-add builder input one))
                  (throw 'emitted builder)))))
        (assert (handler-case (progn (llvm:clear-position temporary-builder) nil)
                  (error (condition) (search "has been released" (princ-to-string condition))))))
      (assert (null (llvm:function-blocks step)))
      (llvm:define-function (step builder module "step" i32) ((input i32))
        (llvm:build-ret builder (llvm:build-add builder input one)))
      (assert (equal '("entry") (mapcar #'llvm:block-name (llvm:function-blocks step))))
      (assert (handler-case
                  (llvm:define-function (duplicate builder module "step" i32) ((input i32))
                    (error "A duplicate definition ran its body."))
                (llvm:llvm-error (condition)
                  (search "already has a body" (llvm:llvm-error-message condition)))))
      (llvm:add-global module "counter" i32)
      (assert (handler-case (progn (llvm:declare-function module "counter" i32 nil) nil)
                (llvm:llvm-error (condition)
                  (search "already in use" (llvm:llvm-error-message condition)))))
      (assert (equal '("step" "run") (mapcar #'llvm:function-name (llvm:module-functions module))))
      (assert (llvm:verify-module module))
      (let ((jit (llvm:make-jit)))
        (llvm:jit-add-module jit module)
        (assert (= 42 (funcall (llvm:bind-jit-function (llvm:jit-lookup jit "run") :int32))))))))

(defun test-errors-and-release ()
