        (assert (= 3 (llvm:layout-store-size layout i24)))
        (assert (= 4 (llvm:layout-alloc-size layout i24)))
        (assert (= 4 (llvm:layout-abi-alignment layout i24)))
        (assert (= 8 (llvm:layout-preferred-alignment layout i24)))
        (assert (= 4 (llvm:layout-field-offset layout record24 1)))
