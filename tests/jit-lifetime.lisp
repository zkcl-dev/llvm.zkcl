(in-package #:zk-llvm/tests)

(defun assert-jit-release-blocked (releaser message)
  (assert (handler-case (progn (funcall releaser) nil)
            (llvm:llvm-error (condition)
              (and (eq 'llvm:release (llvm:llvm-error-operation condition))
                   (search message (llvm:llvm-error-message condition)))))))

(defun assert-jit-name-unloaded (jit name)
  (assert (handler-case (progn (llvm:release (llvm:jit-lookup jit name)) nil)
            (llvm:llvm-error (condition)
              (eq 'llvm:jit-lookup (llvm:llvm-error-operation condition))))))

(defun test-jit-compilation-release ()
  (llvm:with-objects ()
    (llvm:with-jit (jit)
      (multiple-value-bind (answer release-answer)
          (llvm:jit-fn (answer :jit jit) () :i32 41)
        (assert (= 41 (funcall answer)))
        (assert (handler-case
                    (progn (llvm:jit-fn (answer :jit jit) () :i32 -1) nil)
                  (llvm:llvm-error (condition)
                    (and (eq 'llvm:jit-fn (llvm:llvm-error-operation condition))
                         (search "answer" (llvm:llvm-error-message condition))))))
        (llvm:with-jit-binding (bound jit "answer" :i32)
          (assert-jit-release-blocked release-answer "live JIT symbols")
          (assert (= 41 (funcall answer) (funcall bound))))
        (assert (= 41 (funcall answer)))
        (funcall release-answer)
        (assert-jit-name-unloaded jit "answer")
        (assert (handler-case (progn (funcall answer) nil)
                  (error (condition) (search "released" (princ-to-string condition)))))
        (multiple-value-bind (replacement release-replacement)
            (llvm:jit-fn (answer :jit jit) () :i8 42)
          (funcall release-answer)
          (assert (= 42 (funcall replacement)))
          (funcall release-replacement)
          (assert-jit-name-unloaded jit "answer"))))))

(defun test-jit-compilation-dependencies ()
  (llvm:with-objects ()
    (llvm:with-jit (jit)
      (multiple-value-bind (provider release-provider)
          (llvm:jit-fn (provider :jit jit) () :i32 40)
        (multiple-value-bind (dependent release-dependent)
            (llvm:jit-fn (dependent :jit jit) () :i32
              (llvm:declare-ir provider () :i32)
              (llvm:+ (llvm:call 'provider) 1))
          (assert-jit-release-blocked release-provider "submitted JIT code")
          (assert (= 40 (funcall provider)))
          (assert (= 41 (funcall dependent)))
          (funcall release-dependent))
        (multiple-value-bind (child-dependent release-child-dependent)
            (llvm:with-jit (child (llvm:make-jit-dylib jit "jit-lifetime"))
              (llvm:jit-fn (dependent :jit child) () :i32
                (llvm:declare-ir provider () :i32)
                (llvm:+ (llvm:call 'provider) 2)))
          (assert-jit-release-blocked release-provider "live JIT symbols")
          (assert (= 42 (funcall child-dependent)))
          (funcall release-child-dependent))
        (funcall release-provider)
        (assert-jit-name-unloaded jit "provider")))))
