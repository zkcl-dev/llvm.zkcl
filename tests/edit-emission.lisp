(in-package #:zk-llvm/tests)

(defun test-edit-emission ()
  (llvm:with-objects ()
    (llvm:with-context ()
      (let* ((source (llvm:parse-ir "define i32 @adjust(i32 %x) {
        entry:
          %dead = mul i32 %x, 3
          %amount = add i32 %x, 1
          ret i32 %amount
        }"))
             (foreign (llvm:parse-ir "define i32 @other(i32 %x) { ret i32 %x }"))
             (function (llvm:find-function source "adjust"))
             (input (llvm:parameter function 0))
             (amount (llvm:find-instruction function "amount"))
             (dead (llvm:find-instruction function "dead"))
             (exit (llvm:instruction-next amount))
             (original (llvm:module-ir source))
             (edit (llvm:begin-edit source))
             (emitted nil))
        (assert (handler-case
                    (progn (llvm:draft-value edit (llvm:parameter (llvm:find-function foreign "other") 0))
                           nil)
                  (llvm:llvm-error () t)))
        (llvm:with-edit-builder (edit :before exit)
          (assert (handler-case (progn (llvm:+ input 1) nil)
                    (llvm:llvm-error () t)))
          (assert (handler-case (progn (llvm:edit-erase-instruction edit dead) nil)
                    (llvm:llvm-error () t)))
          (setf emitted (llvm:+ (llvm:draft-value edit input) 2))
          (assert (= 1 (llvm:edit-replace-all-uses edit (llvm:instruction-result amount) emitted))))
        (assert (null (llvm:handle-alive-p emitted)))
        (llvm:edit-erase-instruction edit dead)
        (llvm:edit-erase-instruction edit amount)
        (assert (handler-case (progn (llvm:draft-instruction edit dead) nil)
                  (llvm:llvm-error () t)))
        (let ((published (llvm:finish-edit edit)))
          (assert (handler-case (progn (llvm:draft-instruction edit exit) nil)
                    (llvm:llvm-error () t)))
          (assert (llvm:verify-module source))
          (assert (string= original (llvm:module-ir source)))
          (assert (llvm:verify-module published))
          (assert (search "add i32 %x, 2" (llvm:module-ir published)))
          (assert (null (llvm:find-instruction (llvm:find-function published "adjust") "dead")))
          (llvm:with-jit (jit)
            (llvm:with-jit-module (jit published)
              (llvm:with-jit-binding (adjust jit "adjust" :i32 :i32)
                (assert (= 42 (funcall adjust 40)))))))))))
