(in-package #:zk-llvm/tests)

(defun test-typed-literal-constructors ()
  (llvm:with-objects ()
    (llvm:with-context (context)
      (let* ((type (llvm:resolve-type '(:struct :i32 (:array :i8 2))))
             (expected (llvm:const type '(42 (7 8)))))
        (dolist (fields (list '(42 (7 8)) #(42 (7 8))
                             (tl:treelist 42 (tl:treelist 7 8))))
          (let ((value (llvm:const-struct type fields)))
            (assert (llvm:type-equal-p type (llvm:value-type value)))
            (assert (string= (llvm:value-ir expected) (llvm:value-ir value)))))
        (assert (handler-case
                    (progn (llvm:const-struct type '(42 (7 256))) nil)
                  (llvm:llvm-error () t))))
      (let ((i32 (llvm:int-type context 32))
            (llvm:*context* nil))
        (let ((type (llvm:struct-type (vector i32 i32))))
          (assert (equal '(:struct :i32 :i32) (llvm:type-spec type)))
          (assert (llvm:type-equal-p i32 (llvm:type-subtype type 0))))))))

(defun test-type-spec-property ()
  (llvm:with-objects ()
    (llvm:with-context (context)
      (zk-pbt:forall
       (zk-pbt:integers :min 0 :max 64)
       (lambda (size)
         (llvm:with-objects ()
           (let* ((spec (list :struct
                              (list :array (list :int (+ 129 size)) size)
                              (list :vector :i32 (1+ (mod size 8)))))
                  (type (llvm:resolve-type spec context))
                  (description (llvm:type-spec type)))
             (zk-pbt:claim :description (equal spec description)
                           (list spec description))
             (zk-pbt:claim :identity
                           (llvm:type-equal-p type (llvm:resolve-type description context))
                           description))))
       :name 'nested-type-spec-round-trip :seed 42129 :trials 50))))

(defun test-builder-inferred-scope ()
  (llvm:with-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:make-module context "inferred-builder"))
           (function (llvm:declare-function module "increment" :i32 '(:i32)))
           (entry (llvm:append-block function "entry"))
           (llvm:*context* nil)
           (llvm:*module* nil)
           (llvm:*function* nil))
      (llvm:with-builder (:block entry)
        (assert (llvm:block-equal-p entry (llvm:builder-block llvm:*builder*)))
        (assert (llvm:function-equal-p function llvm:*function*))
        (llvm:ret (llvm:+ (llvm:parameter function 0) 1)))
      (llvm:with-builder (builder :before (llvm:block-terminator entry))
        (assert (llvm:block-equal-p entry (llvm:builder-block builder)))
        (assert (llvm:function-equal-p function llvm:*function*))
        (assert (llvm:type-equal-p (llvm:resolve-type :i32)
                                  (llvm:value-type (llvm:parameter function 0))))
        (llvm:clear-position builder)
        (assert (null (llvm:builder-block builder))))
      (assert (null llvm:*context*))
      (assert (null llvm:*module*))
      (assert (null llvm:*function*))
      (assert (llvm:verify-module module))
      (let ((builder (llvm:make-builder context))
            (anchor (llvm:block-terminator entry)))
        (llvm:position-at-end builder entry)
        (llvm:release entry)
        (assert (string= "entry" (llvm:block-name (llvm:builder-block builder))))
        (llvm:position-before builder anchor)
        (llvm:release anchor)
        (llvm:release context)
        (assert (string= "entry" (llvm:block-name (llvm:builder-block builder))))
        (assert (llvm:build-cast builder :sext (llvm:parameter function 0) :i64))
        (llvm:clear-position builder)
        (assert (null (llvm:builder-block builder)))
        (assert (llvm:verify-module module)))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (llvm:with-jit-binding (increment jit "increment" :i32 :i32)
          (assert (= 42 (funcall increment 41))))))))

(defun test-shuffle-literal-masks ()
  (dolist (mask (list '(3 0 2 1) #(3 0 2 1) (tl:treelist 3 0 2 1)
                     '(3 0 -1 1)))
    (multiple-value-bind (pick release)
        (llvm:jit-fn pick ((input :i32)) :i32
          (let* ((type '(:vector :i32 2))
                 (left (llvm:insert-element (llvm:const type '(0 0)) input 0))
                 (right (llvm:const type '(30 40)))
                 (shuffled (llvm:shuffle-vector left right mask)))
            (llvm:extract-element shuffled 1)))
      (unwind-protect (assert (= 42 (funcall pick 42)))
        (funcall release)))))
