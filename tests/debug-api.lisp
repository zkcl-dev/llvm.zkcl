(in-package #:zk-llvm/tests)

(defun test-scoped-debug-location ()
  (llvm:with-objects ()
    (let* ((context (llvm:make-context))
           (module (llvm:make-module context "scoped-debug"))
           (builder (llvm:make-builder context))
           (i32 (llvm:int-type context 32))
           (function (llvm:add-function module "increment"
                                        (llvm:function-type i32 (list i32))))
           (entry (llvm:append-block function "entry"))
           (info (llvm:make-debug-info module "scoped.lisp"))
           (scope (llvm:attach-function-debug-info info function 1))
           (outer (llvm:make-debug-location scope 10 2))
           (inner (llvm:make-debug-location scope 20 4))
           (input (llvm:parameter function 0))
           (one (llvm:const-int i32 1))
           (evaluations nil))
      (llvm:position-at-end builder entry)
      (llvm:with-debug-location (builder inner)
        (assert (= 20 (llvm:debug-location-line (llvm:builder-debug-location builder)))))
      (assert (null (llvm:builder-debug-location builder)))
      (llvm:set-debug-location builder outer)
      ;; Caller names deliberately resemble implementation locals.
      (let ((previous :caller) (location-value :caller) (engine :caller))
        (multiple-value-bind (first second)
            (llvm:with-debug-location
                ((progn (push :builder evaluations) builder)
                 (progn (push :location evaluations) inner))
              (assert (eq previous :caller))
              (assert (eq location-value :caller))
              (assert (eq engine :caller))
              (let ((sum (llvm:build-add builder input one)))
                (assert (= 20 (llvm:debug-location-line
                               (llvm:instruction-debug-location (llvm:value-instruction sum))))))
              (llvm:with-debug-location (builder nil)
                (assert (null (llvm:builder-debug-location builder))))
              (assert (= 20 (llvm:debug-location-line (llvm:builder-debug-location builder))))
              (values :first :second))
          (assert (eq first :first))
          (assert (eq second :second))))
      (assert (equal evaluations '(:location :builder)))
      (assert (= 10 (llvm:debug-location-line (llvm:builder-debug-location builder))))
      (assert (eq :escaped
                  (catch 'leave-location
                    (llvm:with-debug-location (builder inner)
                      (throw 'leave-location :escaped)))))
      (assert (= 10 (llvm:debug-location-line (llvm:builder-debug-location builder))))
      ;; Restoring metadata after emitting a terminator must not require a new
      ;; legal instruction insertion point.
      (llvm:with-debug-location (builder inner)
        (llvm:build-ret builder input))
      (assert (= 10 (llvm:debug-location-line (llvm:builder-debug-location builder))))
      (llvm:finish-debug-info info)
      (llvm:verify-module module))))
