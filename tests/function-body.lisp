(in-package #:zk-llvm/tests)

(defun test-function-body-rollback ()
  (llvm:with-objects ()
    (let* ((module (llvm:make-module (llvm:make-context) "body-rollback"))
           (function (llvm:declare-function module "step" :i32 '(:i32)))
           (parameter (llvm:parameter function 0))
           (address (llvm:function-address function))
           (other-builder (llvm:make-builder (llvm:module-context module)))
           (entry nil)
           (instruction nil)
           (result nil)
           (label-address nil)
           (address-array nil))
      (llvm:set-value-name parameter "original")
      (llvm:set-function-calling-convention function :fast)
      (llvm:set-function-attribute function :function "nounwind")
      (flet ((llvm-failure-p (call message)
               (handler-case (progn (funcall call) nil)
                 (llvm:llvm-error (condition)
                   (unless (search message (llvm:llvm-error-message condition))
                     (error "Expected an LLVM error mentioning ~S, got ~A." message condition))
                   t))))
        (let ((failure (make-condition 'simple-error :format-control "Test emitter error.")))
          (assert (eq failure
                      (handler-case
                          (llvm:emit-function-body function '("attempt")
                            (lambda (parameters)
                              (llvm:set-function-calling-convention function :cold)
                              (llvm:remove-function-attribute function :function "nounwind")
                              (llvm:set-function-attribute function :function "noinline")
                              (setf entry (llvm:builder-block llvm:*builder*)
                                    result (llvm:build-add llvm:*builder* (first parameters)
                                                          (llvm:const :i32 1) "sum")
                                    instruction (llvm:block-last-instruction entry))
                              (let ((target (llvm:append-block function "target")))
                                (setf label-address (llvm:block-address target)
                                      address-array (llvm:const-array :ptr (list label-address)))
                                (assert (llvm-failure-p
                                         (lambda ()
                                           (llvm:add-global module "escaped" '(:array :ptr 1)
                                                            :initializer address-array))
                                         "unfinished LLVM function body"))
                                (llvm:indirect-br label-address (list target))
                                (llvm:position-at-end llvm:*builder* target))
                              (llvm:position-before other-builder instruction)
                              (error failure)))
                        (simple-error (condition) condition)))))
        (assert (null (llvm:function-blocks function)))
        (assert (llvm:function-equal-p function (llvm:find-function module "step")))
        (assert (llvm:value-equal-p address (llvm:function-address function)))
        (assert (llvm:value-equal-p parameter (llvm:parameter function 0)))
        (assert (string= "original" (llvm:value-name parameter)))
        (assert (= 8 (llvm:function-calling-convention function)))
        (assert (llvm:function-has-attribute-p function :function "nounwind"))
        (assert (not (llvm:function-has-attribute-p function :function "noinline")))
        (assert (llvm:verify-module module))
        (assert (llvm:handle-alive-p parameter))
        (dolist (object (list entry instruction result label-address address-array))
          (assert (not (llvm:handle-alive-p object)))
          (assert (search ":ABANDONED" (prin1-to-string object))))
        (dolist (read (list (cons :block (lambda () (llvm:block-name entry)))
                            (cons :instruction (lambda () (llvm:instruction-ir instruction)))
                            (cons :ssa (lambda () (llvm:value-ir result)))
                            (cons :address (lambda () (llvm:block-address-target label-address)))
                            (cons :address-array (lambda () (llvm:value-ir address-array)))
                            (cons :insertion-block (lambda () (llvm:builder-block other-builder)))
                            (cons :builder (lambda ()
                                             (llvm:build-add other-builder parameter parameter)))))
          (assert (llvm-failure-p (cdr read) "abandoned function body")
                  () "Abandoned LLVM ~A handle remained usable." (car read)))
        (assert (llvm-failure-p
                 (lambda ()
                   (llvm:emit-function-body function '("unverified")
                     (lambda (parameters)
                       (declare (ignore parameters))
                       (llvm:append-block function "unfinished"))))
                 "has no terminator"))
        (assert (null (llvm:function-blocks function)))
        (assert (llvm-failure-p
                 (lambda ()
                   (llvm:emit-function-body function '("invalid")
                     (lambda (parameters)
                       (let ((entry (llvm:builder-block llvm:*builder*))
                             (join (llvm:append-block function "join"))
                             (phi nil))
                         (llvm:build-br llvm:*builder* join)
                         (llvm:position-at-end llvm:*builder* join)
                         (setf phi (llvm:build-phi llvm:*builder* :i32 "value"))
                         (llvm:add-incoming phi (first parameters) entry)
                         (llvm:add-incoming phi (first parameters) join)
                         (llvm:build-ret llvm:*builder* phi)))))
                 "failed verification"))
        (assert (null (llvm:function-blocks function)))
        (assert (eq function
                    (llvm:emit-function-body function '("input")
                      (lambda (parameters)
                        (assert (llvm:value-equal-p parameter (first parameters)))
                        (assert (llvm-failure-p
                                 (lambda () (llvm:ret result))
                                 "abandoned function body"))
                        (llvm:build-ret llvm:*builder* (llvm:+ (first parameters) 1))
                        (assert (llvm-failure-p
                                 (lambda () (llvm:module-bitcode module))
                                 "finish all LLVM function bodies"))))))
        (llvm:define-function (wrapper builder module "run" :i32) ()
          (llvm:build-ret builder (llvm:build-call builder function (list (llvm:const :i32 41)))))
        (llvm:with-jit (jit)
          (llvm:jit-add-module jit module)
          (assert (= 42 (funcall (llvm:jit-bind jit "run" :i32)))))))))

(defun test-named-function-body-retry ()
  (llvm:with-objects ()
    (llvm:with-module (module "named-retry")
      (assert (eq :aborted
                  (catch 'abort-function
                    (llvm:defir (hidden :linkage :internal) () :i32
                      (llvm:build-ret llvm:*builder* (llvm:const :i32 0))
                      (throw 'abort-function :aborted)))))
      (let ((declaration (llvm:find-function module "hidden")))
        (assert (null (llvm:function-blocks declaration)))
        (assert (eq :external (llvm:function-linkage declaration)))
        (assert (llvm:verify-module module))
        (let ((definition (llvm:defir (hidden :linkage :internal) () :i32
                            (assert (eq module llvm:*module*))
                            42)))
          (assert (llvm:function-equal-p declaration definition))
          (assert (eq module (llvm:function-module definition)))
          (assert (eq :internal (llvm:function-linkage definition)))))
      (llvm:defir run () :i32 (llvm:call 'hidden))
      (llvm:with-jit (jit)
        (llvm:jit-add-module jit module)
        (assert (= 42 (funcall (llvm:jit-bind jit "run" :i32))))))))

(defun test-debug-function-body-rollback ()
  (llvm:with-objects ()
    (let* ((module (llvm:make-module (llvm:make-context) "debug-rollback"))
           (function (llvm:declare-function module "step" :i32 '(:i32)))
           (info (llvm:make-debug-info module "retry.lisp" :emission :full))
           (scope nil)
           (location nil))
      (assert (eq :aborted
                  (catch 'abort-function
                    (llvm:emit-function-body function '("input")
                      (lambda (parameters)
                        (setf scope (llvm:attach-function-debug-info info function 3)
                              location (llvm:make-debug-location scope 4))
                        (llvm:set-debug-location llvm:*builder* location)
                        (llvm:build-ret llvm:*builder* (first parameters))
                        (throw 'abort-function :aborted))))))
      (assert (null (llvm:function-debug-scope function)))
      (llvm:emit-function-body function '("input")
        (lambda (parameters)
          (let* ((next-scope (llvm:attach-function-debug-info info function 6))
                 (next-location (llvm:make-debug-location next-scope 7)))
            (assert (handler-case (progn (llvm:set-debug-location llvm:*builder* location) nil)
                      (llvm:llvm-error (condition)
                        (search "abandoned function body" (llvm:llvm-error-message condition)))))
            (llvm:set-debug-location llvm:*builder* next-location)
            (llvm:build-ret llvm:*builder* (first parameters)))))
      (llvm:finish-debug-info info)
      (assert (llvm:verify-module module))
      (assert (= 6 (llvm:debug-scope-line (llvm:function-debug-scope function)))))))
