(defpackage #:zk-llvm/examples/explicit-ir
  (:use #:cl)
  (:local-nicknames (#:llvm #:zk-llvm))
  (:export #:main))
(in-package #:zk-llvm/examples/explicit-ir)

(defun positive-part-module ()
  (llvm:define-module (module "positive-part")
    (llvm:define-function (function builder module "positive_part" :i64) ((x :i64))
      (let* ((zero (llvm:const :i64 0))
             (keep (llvm:append-block function "keep"))
             (floor (llvm:append-block function "floor"))
             (join (llvm:append-block function "join"))
             (positive (llvm:build-icmp builder :sgt x zero "positive")))
        (llvm:build-cond-br builder positive keep floor)
        (llvm:position-at-end builder keep)
        (llvm:build-br builder join)
        (llvm:position-at-end builder floor)
        (llvm:build-br builder join)
        (llvm:position-at-end builder join)
        (let ((answer (llvm:build-phi builder :i64 "answer")))
          (llvm:add-incoming answer x keep)
          (llvm:add-incoming answer zero floor)
          (llvm:build-ret builder answer))))))

(defun main ()
  (llvm:with-objects ()
    (let ((module (positive-part-module)))
      (write-string (llvm:module-ir module))
      (llvm:with-jit (jit)
        (llvm:with-jit-module (jit module)
          (llvm:with-jit-binding (positive-part jit "positive_part" :i64 :i64)
            (assert (= 0 (funcall positive-part -7)))
            (assert (= 8 (funcall positive-part 8)))))))))
